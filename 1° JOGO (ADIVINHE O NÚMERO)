#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void limparBuffer(void) {
	int c;
	while ((c = getchar()) != '\n' && c != EOF);
}
void limparTela (void) {
#ifdef _WIN32 
	system("cls");  
#else
	system("clear"); 
#endif
}
void adivinheNumero (void) {
	int joga_novamete;
	int palpite;

	do {
		int numero_random = rand() % 101;
		int acertou = 0;
        
        limparTela();
		printf("\033[1;34m==================\nADIVINHE O NÚMERO\n==================\n\033[0m");
		printf("Você terá 7 tentativas para adivinhar um número aleatório de 0 a 100\n");

		for (int i = 1; i <= 7; i++) {
			printf("Digite o seu palpite: ");


			if (scanf("%d", &palpite) != 1) {
				printf("Entrada inválida! Digite apenas números inteiros.\n");
				limparBuffer(); 
				i--;            
				continue;
			}

			if (palpite < 0 || palpite > 100) {
				printf("Número inválido! Escolha um número entre 0 e 100.\n");
				i--; 
			} else if(palpite < numero_random) {
				printf("O número escondido é \033[1;32mMAIOR\033[0m que \033[1;33m%d.\n\033[0m", palpite);
			} else if (palpite > numero_random) {
				printf("O número escondido é \033[1;31mMENOR\033[0m que \033[1;33m%d.\n\033[0m", palpite);
			} else {
				printf("\n\033[32m PARABÉNS VOCÊ ACERTOU O NÚMERO ESCONDIDO!!! ERA O %d \033[0m\n", numero_random);
				acertou = 1;
				break;
			}
		}

		if (!acertou) {
			printf("\n\033[1;31mVocê atingiu o limite de tentativas! O número correto era %d.\n\033[0m", numero_random);
		}

		printf("\nDeseja jogar novamente? (1 - Sim / 0 - Não): ");
		while (scanf("%d", &joga_novamete) != 1) {
			printf("Opção inválida! Digite 1 para sim ou 0 para sair: ");
			limparBuffer();
		}

	} while(joga_novamete != 0);

	printf("Obrigado por ter jogado, volte sempre!!!\n");
	limparTela();
}
int main()
{
    adivinheNumero();
    
    return 0;
}
