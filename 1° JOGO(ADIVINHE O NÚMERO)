#include <stdio.h>
#include <stdlib.h>

void limparBuffer(void) {
	int c;
	while ((c = getchar()) != '\n' && c != EOF);
}

void adivinheNumero (void) {
	int joga_novamete;
	int palpite;

	do {
		// O número random e as tentativas devem resetar a cada novo jogo
		int numero_random = rand() % 101;
		int acertou = 0;

		printf("\n===OLÁ, VOCÊ ESTÁ PARTICIPANDO DO JOGO ADIVINHE O NÚMERO!===\n");
		printf("Você terá 7 tentativas para adivinhar um número aleatório de 0 a 100\n");

		for (int i = 1; i <= 7; i++) {
			printf("Digite o seu palpite: ");

			// scanf retorna o número de itens lidos com sucesso. Se for diferente de 1, não é um número.
			if (scanf("%d", &palpite) != 1) {
				printf("Entrada inválida! Digite apenas números inteiros.\n");
				limparBuffer(); // Limpa a letra digitada para não travar o programa
				i--;            // Não pune o jogador, permitindo tentar a mesma tentativa de novo
				continue;
			}

			if (palpite < 0 || palpite > 100) {
				printf("Número inválido! Escolha um número entre 0 e 100.\n");
				i--; // Não aceita entrada inválida! Digite apenas números inteiros.onta como tentativa se o número for fora do escopo
			} else if(palpite < numero_random) {
				printf("O número escondido é MAIOR que %d.\n", palpite);
			} else if (palpite > numero_random) {
				printf("O número escondido é MENOR que %d.\n", palpite);
			} else {
				printf("\n\033[32m PARABÉNS VOCÊ ACERTOU O NÚMERO ESCONDIDO!!! ERA O %d \033[0m\n", numero_random);
				acertou = 1;
				break;
			}
		}

		if (!acertou) {
			printf("\nVocê atingiu o limite de tentativas! O número correto era %d.\n", numero_random);
		}

		printf("\nDeseja jogar novamente? (1 - Sim / 0 - Não): ");
		while (scanf("%d", &joga_novamete) != 1) {
			printf("Opção inválida! Digite 1 para sim ou 0 para sair: ");
			limparBuffer();
		}

	} while(joga_novamete != 0);

	printf("Obrigado por ter jogado, volte sempre!!!\n");
}
int main(){
    //PARA POR NO GITHUB
    int joga_novamete = 1;
    printf("1° PRIMEIRO JOGO DO LAUNCHER\n");
    do{
        adivinheNumero();
        printf("\nDeseja sair, digite 0, para jogar novamente, digite 1:");
        scanf("%d", &joga_novamete);
    } while(joga_novamete != 0);
}